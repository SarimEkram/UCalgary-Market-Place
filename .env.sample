# ---- Local docker-compose (unchanged) ----
DB_PASSWORD=change_me_to_a_strong_password
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
JWT_SECRET=change_me_to_a_random_64_char_string

# ---- Extra vars for a hosted (free) deploy ----
# See DEPLOY.md. These are set in the host's dashboard, not in this file.
#
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-app.onrender.com   # the app's own public URL (same-origin)
#
# MySQL (hosted):
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_USER=your-mysql-user
# DB_NAME=marketplace
# DB_SSL=true                 # hosted MySQL requires TLS
# DB_SSL_CA=<paste ca.pem>    # optional: verify against the host's CA
# DB_CONNECTION_LIMIT=5       # match your host's free connection cap
#
# Redis (hosted, e.g. Upstash):
# REDIS_URL=rediss://default:password@your-host:6379
#
# Cookies (only needed for a SPLIT deploy on a different frontend domain):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
